# Copie este arquivo para ".env" e preencha. O .env NÃO vai para o git.
# Depois de mudar o .env, é só compilar/gravar de novo.

# Rede Wi-Fi onde o torrador vai se conectar.
# Deixe WIFI_SSID vazio para o ESP32 criar a própria rede (modo AP).
WIFI_SSID=
WIFI_PASS=

# Rede criada pelo ESP32 no modo AP (ou se não conseguir conectar na rede acima).
# A senha precisa ter pelo menos 8 caracteres.
AP_SSID=Torrador
AP_PASS=torra1234

# Nome na rede: a página fica em http://<HOSTNAME>.local
HOSTNAME=torrador
